<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Lumenhop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="LumenAccentBrush" Color="#2EE6C7" />
            <SolidColorBrush x:Key="LumenAccentSoftBrush" Color="#332EE6C7" />

            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,14" />
                <Setter
                    Property="Background"
                    Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                />
                <Setter
                    Property="BorderBrush"
                    Value="{ThemeResource CardStrokeColorDefaultBrush}"
                />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style
                x:Key="SectionHeaderStyle"
                TargetType="TextBlock"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            >
                <Setter Property="Margin" Value="0,12,0,8" />
            </Style>

            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
