<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lumenhop.Controls.StatusDot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="28"
    Height="28"
    Tapped="OnTapped"
>
    <UserControl.Resources>
        <Storyboard x:Name="Pulse" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="HaloScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.55"
                To="2.35"
                Duration="0:0:1.6"
            />
            <DoubleAnimation
                Storyboard.TargetName="HaloScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.55"
                To="2.35"
                Duration="0:0:1.6"
            />
            <DoubleAnimation
                Storyboard.TargetName="Halo"
                Storyboard.TargetProperty="Opacity"
                From="0.5"
                To="0.0"
                Duration="0:0:1.6"
            />
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Pop" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Ellipse
            x:Name="Halo"
            Width="12"
            Height="12"
            Opacity="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5"
        >
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse
            x:Name="Ring"
            Width="16"
            Height="16"
            StrokeThickness="1.2"
            Fill="Transparent"
            Opacity="0.35"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
        />
        <Ellipse
            x:Name="Dot"
            Width="9"
            Height="9"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
        />
    </Grid>
</UserControl>
