<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lumenhop.Controls.CornerPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <StackPanel Spacing="10" HorizontalAlignment="Left">
        <Border
            Width="168"
            Height="108"
            CornerRadius="12"
            Padding="10"
            BorderThickness="1.5"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
        >
            <Grid RowSpacing="8" ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="TopLeftButton"
                    Grid.Row="0"
                    Grid.Column="0"
                    Tag="TopLeft"
                    Click="OnCornerClick"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                />
                <Button
                    x:Name="TopRightButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    Tag="TopRight"
                    Click="OnCornerClick"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                />
                <Button
                    x:Name="BottomLeftButton"
                    Grid.Row="1"
                    Grid.Column="0"
                    Tag="BottomLeft"
                    Click="OnCornerClick"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                />
                <Button
                    x:Name="BottomRightButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    Tag="BottomRight"
                    Click="OnCornerClick"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                />
            </Grid>
        </Border>
        <TextBlock
            x:Name="CaptionText"
            Opacity="0.75"
            Style="{ThemeResource CaptionTextBlockStyle}"
        />
    </StackPanel>
</UserControl>
