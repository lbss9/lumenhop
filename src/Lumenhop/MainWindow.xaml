<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lumenhop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lumenhop"
>
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.Column="0"
                Width="18"
                Height="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
            >
                <Ellipse Width="18" Height="18" Fill="{StaticResource LumenAccentSoftBrush}" />
                <Ellipse
                    Width="8"
                    Height="8"
                    Fill="{StaticResource LumenAccentBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                />
            </Grid>
            <TextBlock
                Grid.Column="1"
                Text="Lumenhop"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
            />
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            IsSettingsVisible="True"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="196"
            CompactPaneLength="48"
            Background="Transparent"
            SelectionChanged="OnNavSelectionChanged"
        >
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <AcrylicBrush
                    x:Key="NavigationViewDefaultPaneBackground"
                    TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                    TintOpacity="0"
                    TintLuminosityOpacity="0"
                    FallbackColor="Transparent"
                />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNav" x:Uid="Nav_Home" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="OutageNav" x:Uid="Nav_Outage" Tag="outage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE704;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutNav" x:Uid="Nav_About" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
