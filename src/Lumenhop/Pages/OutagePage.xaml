<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lumenhop.Pages.OutagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Grid Padding="8,4,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock x:Uid="Outage_Heading" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBlock
                x:Uid="Outage_Summary"
                Opacity="0.7"
                Style="{ThemeResource CaptionTextBlockStyle}"
            />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="10"
            MaxWidth="260"
        >
            <Grid Width="44" Height="44" HorizontalAlignment="Center">
                <Ellipse Fill="{StaticResource LumenAccentSoftBrush}" />
                <FontIcon
                    Glyph="&#xE704;"
                    FontSize="18"
                    Foreground="{StaticResource LumenAccentBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                />
            </Grid>
            <TextBlock
                x:Uid="Outage_EmptyTitle"
                HorizontalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
            />
            <TextBlock
                x:Uid="Outage_EmptyBody"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Opacity="0.7"
                Style="{ThemeResource CaptionTextBlockStyle}"
            />
        </StackPanel>
    </Grid>
</Page>
