<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lumenhop.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lumenhop"
    xmlns:ctrl="using:Lumenhop.Controls"
>
    <Page.Resources>
        <DataTemplate x:Key="TargetCardTemplate" x:DataType="local:PingTargetViewModel">
            <Border
                CornerRadius="12"
                Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                PointerEntered="OnCardPointerEntered"
                PointerExited="OnCardPointerExited"
            >
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="36"
                        Height="36"
                        CornerRadius="10"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        VerticalAlignment="Center"
                    >
                        <Grid>
                            <FontIcon
                                Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                                FontSize="16"
                                Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                            <Image
                                Source="{x:Bind IconImage, Mode=OneWay}"
                                Width="22"
                                Height="22"
                                Stretch="UniformToFill"
                                Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                            />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                        />
                        <TextBlock
                            Text="{x:Bind Host, Mode=OneWay}"
                            Opacity="0.62"
                            FontFamily="Cascadia Mono, Consolas, Courier New"
                            TextTrimming="CharacterEllipsis"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                        />
                    </StackPanel>

                    <Grid Grid.Column="2" ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <ctrl:StatusDot
                                State="{x:Bind StateKey, Mode=OneWay}"
                                DotColor="{x:Bind StatusColor, Mode=OneWay}"
                                HorizontalAlignment="Center"
                            />
                            <TextBlock
                                Text="{x:Bind LatencyText, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                            />
                        </StackPanel>
                        <Button
                            x:Name="MoreButton"
                            Grid.Column="1"
                            Tag="{x:Bind}"
                            Click="OnCardMenuClick"
                            Style="{StaticResource GhostButtonStyle}"
                            Opacity="0"
                        >
                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="8,4,8,8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Uid="Home_Heading" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Name="SummaryText"
                    Opacity="0.7"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                />
            </StackPanel>
            <Button
                Grid.Column="1"
                Click="OnAdd"
                Style="{ThemeResource AccentButtonStyle}"
                Padding="10,6"
            >
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <TextBlock x:Uid="Home_Add" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListView
                x:Name="TargetList"
                Padding="0"
                SelectionMode="None"
                ItemTemplate="{StaticResource TargetCardTemplate}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            >
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,10,8" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <StackPanel
                x:Name="EmptyState"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="10"
                MaxWidth="260"
                Visibility="Collapsed"
            >
                <Grid Width="44" Height="44" HorizontalAlignment="Center">
                    <Ellipse Fill="{StaticResource LumenAccentSoftBrush}" />
                    <FontIcon
                        Glyph="&#xE704;"
                        FontSize="18"
                        Foreground="{StaticResource LumenAccentBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                    />
                </Grid>
                <TextBlock
                    x:Uid="Home_EmptyTitle"
                    HorizontalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                />
                <TextBlock
                    x:Uid="Home_EmptyBody"
                    HorizontalAlignment="Center"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Opacity="0.7"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
